# Copy this file to .env and fill in your values.
# .env is gitignored; this file is committed as a reference.

PLEX_URL=http://localhost:32400
PLEX_TOKEN=

SONARR_URL=http://localhost:8989
SONARR_API_KEY=
# Optional. If unset, the app auto-uses the only available Sonarr root folder.
SONARR_ROOT_FOLDER=
# Optional. If unset, the app auto-uses the only available Sonarr quality profile.
SONARR_QUALITY_PROFILE=
# Optional. When true, queue a Sonarr season search after a season is added/enabled.
SEARCH_ADDED=false
# Optional. When true, queue a Sonarr season search even when the requested sync already exists.
SEARCH_EXISTING=false

RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Name of the Plex collection to sync to Sonarr
PLEX_TV_COLLECTION=
# Name of the Plex collection to sync to Radarr
PLEX_MOVIE_COLLECTION=
