# Copy this file to .env and fill in your values.
# .env is gitignored; this file is committed as a reference.

PLEX_URL=http://localhost:32400
PLEX_TOKEN=

SONARR_URL=http://localhost:8989
SONARR_API_KEY=
# Optional. If unset, the app auto-uses the only available Sonarr root folder.
SONARR_ROOT_FOLDER=
# Optional. If unset, the app auto-uses the only available Sonarr quality profile.
SONARR_QUALITY_PROFILE=
# Optional. When true, queue a Sonarr season search after a season is added/enabled.
# Also applies to Radarr by queuing a movie search after a movie is added/enabled.
SEARCH_ADDED=false
# Optional. When true, queue a Sonarr season search even when the requested sync already exists.
# Also applies to Radarr by queuing a movie search even when the requested sync already exists.
SEARCH_EXISTING=false

RADARR_URL=http://localhost:7878
RADARR_API_KEY=
# Optional. If unset, the app auto-uses the only available Radarr root folder.
RADARR_ROOT_FOLDER=
# Optional. If unset, the app auto-uses the only available Radarr quality profile.
RADARR_QUALITY_PROFILE=

# Name of the Plex collection to sync to Sonarr
PLEX_TV_COLLECTION=
# Name of the Plex collection to sync to Radarr
PLEX_MOVIE_COLLECTION=

# Optional. Repeat the sync on this interval (e.g. 10m, 1h, 6h, 3d).
# If unset or empty, the run command syncs once and exits.
INTERVAL=
# Optional. Time zone used for interval status timestamps. Defaults to UTC.
TZ=
